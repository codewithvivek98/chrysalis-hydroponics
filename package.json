{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager":"npm@11.19.1",
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "next dev",
    "dev:server": "tsx server/src/server.ts",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "start:server": "node server/dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "seed:dev-users": "node --env-file-if-exists=server/.env --import tsx server/src/scripts/seed-test-users.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@emailjs/browser": "^5.0.3",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.16.0",
    "mongoose": "^9.11.2",
    "next": "16.4.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}